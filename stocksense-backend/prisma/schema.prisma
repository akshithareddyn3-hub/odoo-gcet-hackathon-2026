// StockSense — core data model
// Design principle: every stock-changing action (receipt, delivery,
// transfer, adjustment) creates one or more StockMove rows, and each
// StockMove is the single place that updates Product.qtyOnHand.
// This keeps the "ledger" requirement (every movement logged) automatic
// instead of something each feature has to remember to do separately.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  STAFF
}

enum MoveType {
  RECEIPT
  DELIVERY
  TRANSFER
  ADJUSTMENT
}

enum DocStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String // bcrypt hash, never store plain text
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
}

model Warehouse {
  id             Int             @id @default(autoincrement())
  name           String
  code           String          @unique
  createdAt      DateTime        @default(now())
  products       Product[]
  receipts       Receipt[]
  deliveryOrders DeliveryOrder[]
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  sku          String   @unique
  category     String
  uom          String // unit of measure, e.g. "kg", "pcs"
  qtyOnHand    Float    @default(0)
  reorderLevel Float    @default(0)
  warehouseId  Int
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  stockMoves   StockMove[]
  createdAt    DateTime @default(now())

  @@index([warehouseId])
}

model Receipt {
  id           Int       @id @default(autoincrement())
  supplierName String
  warehouseId  Int
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  status       DocStatus @default(DRAFT)
  stockMoves   StockMove[]
  createdAt    DateTime  @default(now())
}

model DeliveryOrder {
  id           Int       @id @default(autoincrement())
  customerName String
  warehouseId  Int
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  status       DocStatus @default(DRAFT)
  stockMoves   StockMove[]
  createdAt    DateTime  @default(now())
}

// The stock ledger. Every receipt line, delivery line, transfer, or
// adjustment is one row here. fromLocation/toLocation are simple text
// labels ("Main Warehouse", "Production Rack") — enough for the hackathon
// scope without a full locations graph.
model StockMove {
  id              Int            @id @default(autoincrement())
  product         Product        @relation(fields: [productId], references: [id])
  productId       Int
  type            MoveType
  quantity        Float // always positive; sign/effect is derived from `type`
  fromLocation    String?
  toLocation      String?
  status          DocStatus      @default(DONE)
  note            String?
  receiptId       Int?
  receipt         Receipt?       @relation(fields: [receiptId], references: [id])
  deliveryOrderId Int?
  deliveryOrder   DeliveryOrder? @relation(fields: [deliveryOrderId], references: [id])
  createdAt       DateTime       @default(now())

  @@index([productId])
  @@index([type])
}
